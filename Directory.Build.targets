<Project>
  <!-- The WebView2 package also references its WPF control, which pulls in WindowsBase and
       conflicts in a WinForms-only app (MSB3277). stockpanel uses only the WinForms control. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
